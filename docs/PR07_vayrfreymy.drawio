999999;" vertex="1" parent="1"><mxGeometry x="36" y="80" width="328" height="1" as="geometry"/></mxCell><mxCell id="sc08-6" value="" style="rounded=1;strokeColor=none;arcSize=50;fillColor=#333333;" vertex="1" parent="1"><mxGeometry x="36.0" y="90" width="104.0" height="6" as="geometry"/></mxCell><mxCell id="sc08-7" value="" style="rounded=1;strokeColor=none;arcSize=50;fillColor=#333333;" vertex="1" parent="1"><mxGeometry x="148.0" y="90" width="104.0" height="6" as="geometry"/></mxCell><mxCell id="sc08-8" value="" style="rounded=1;strokeColor=none;arcSize=50;fillColor=#CCCCCC;" vertex="1" parent="1"><mxGeometry x="260.0" y="90" width="104.0" height="6" as="geometry"/></mxCell><mxCell id="sc08-9" value="✓ Подобрали свободных мастеров рядом" style="fontColor=#222222;rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="36" y="104" width="328" height="30" as="geometry"/></mxCell><mxCell id="sc08-10" value="&lt;b&gt;Алишер Т.&lt;/b&gt;  ★ 4,9 (132)&lt;br&gt;&lt;span style='font-size:11px'&gt;1,8 км · свободен в 15:00 · 95 000 сум&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:10.5px;color:#2D5F1E'&gt;&lt;b&gt;Почему рекомендуем:&lt;/b&gt; лучший рейтинг среди мастеров в 2 км,&lt;br&gt;свободен в выбранное время. Отзыв: «Быстро и аккуратно»&lt;/span&gt;" style="fontColor=#222222;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;arcSize=12;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="36" y="142" width="328" height="92" as="geometry"/></mxCell><mxCell id="sc08-11" value="&lt;b&gt;Бахром Р.&lt;/b&gt;  ★ 4,8 (87)&lt;br&gt;&lt;span style='font-size:11px'&gt;3,2 км · свободен в 15:30 · 90 000 сум&lt;/span&gt;" style="fontColor=#222222;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="36" y="242" width="328" height="58" as="geometry"/></mxCell><mxCell id="sc08-12" value="&lt;b&gt;Сардор К.&lt;/b&gt;  ★ 4,7 (54)&lt;br&gt;&lt;span style='font-size:11px'&gt;2,5 км · свободен в 16:00 · 85 000 сум&lt;/span&gt;" style="fontColor=#222222;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="36" y="308" width="328" height="58" as="geometry"/></mxCell><mxCell id="sc08-13" value="&lt;b&gt;Итого: 95 000 сум&lt;/b&gt; (предварительно)&lt;br&gt;&lt;span style='font-size:11px'&gt;Оплата: Payme ▾ · после выполнения работы&lt;/span&gt;" style="fontColor=#222222;rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="36" y="380" width="328" height="48" as="geometry"/></mxCell><UserObject id="sc08-14" label="Подтвердить заказ" link="data:page/id,sc11"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#FFFFFF;fontStyle=1;fontSize=13;arcSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="632" width="328" height="44" as="geometry"/></mxCell></UserObject><mxCell id="sc08-15" value="Выбрать другого мастера" style="fontColor=#222222;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#333333;fontSize=12;arcSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="684" width="328" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sc11" name="SC-11 Статус заказа"><mxGraphModel dx="800" dy="800" grid="0" gridSize="10" guides="1" page="1" pageWidth="700" pageHeight="800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sc11-1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#333333;strokeWidth=3;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="360" height="740" as="geometry"/></mxCell><mxCell id="sc11-2" value="" style="rounded=1;fillColor=#333333;strokeColor=none;arcSize=50;" vertex="1" parent="1"><mxGeometry x="160" y="30" width="80" height="8" as="geometry"/></mxCell><UserObject id="sc11-3" label="&lt;b&gt;←  Заказ № 10245&lt;/b&gt;" link="data:page/id,sc01"><mxCell style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;fontColor=#222222;fontSize=14;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="248" height="30" as="geometry"/></mxCell></UserObject><mxCell id="sc11-4" value="⟳" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;fontColor=#222222;align=right;fontSize=12;" vertex="1" parent="1"><mxGeometry x="254" y="46" width="110" height="30" as="geometry"/></mxCell><mxCell id="sc11-5" value="" style="line;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="36" y="80" width="328" height="1" as="geometry"/></mxCell><mxCell id="sc11-6" value="&lt;b&gt;Замена смесителя&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Завтра, 15:00–17:00 · Юнусабад, 4-кв., д. 12&lt;/span&gt;" style="fontColor=#222222;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="36" y="92" width="328" height="46" as="geometry"/></mxCell><mxCell id="sc11-7" value="&lt;b&gt;Алишер Т.&lt;/b&gt; · ★ 4,9&lt;br&gt;&lt;span style='font-size:11px'&gt;Сантехник, 6 лет опыта&lt;/span&gt;" style="fontColor=#222222;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontSize=12;align=left;spacingLeft=8;arcSize=12;" vertex="1" parent="1"><mxGeometry x="36" y="146" width="328" height="46" as="geometry"/></mxCell><mxCell id="sc11-8" value="📞 Позвонить" style="fontColor=#222222;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#333333;fontSize=12;arcSize=18;" vertex="1" parent="1"><mxGeometry x="36" y="200" width="160.0" height="36" as="geometry"/></mxCell><mxCell id="sc11-9" value="💬 Чат" style="fontColor=#222222;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#333333;fontSize=12;arcSize=18;" vertex="1" parent="1"><mxGeometry x="204.0" y="200" width="160.0" height="36" as="geometry"/></mxCell><mxCell id="sc11-10" value="[ карта: мастер в пути · ~12 мин ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="246" width="328" height="90" as="geometry"/></mxCell><mxCell id="sc11-11" value="●  Новый · 14:02" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;fontColor=#222222;fontSize=12;" vertex="1" parent="1"><mxGeometry x="36" y="346" width="328" height="24" as="geometry"/></mxCell><mxCell id="sc11-12" value="●  Принят мастером · 14:04" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;fontColor=#222222;fontSize=12;" vertex="1" parent="1"><mxGeometry x="36" y="372" width="328" height="24" as="geometry"/></mxCell><mxCell id="sc11-13" value="●  &lt;b&gt;Мастер выехал · 14:40&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;fontColor=#222222;fontSize=12;" vertex="1" parent="1"><mxGeometry x="36" y="398" width="328" height="24" as="geometry"/></mxCell><mxCell id="sc11-14" value="○  В работе" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;fontColor=#222222;fontSize=12;" vertex="1" parent="1"><mxGeometry x="36" y="424" width="328" height="24" as="geometry"/></mxCell><mxCell id="sc11-15" value="○  Завершён → оплата и отзыв" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;fontColor=#222222;fontSize=12;" vertex="1" parent="1"><mxGeometry x="36" y="450" width="328" height="24" as="geometry"/></mxCell><mxCell id="sc11-16" value="Предварительно: 95 000 сум · оплата Payme после работы" style="fontColor=#222222;rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontSize=12;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="36" y="486" width="328" height="34" as="geometry"/></mxCell><mxCell id="sc11-17" value="&lt;u&gt;Отменить заказ&lt;/u&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;fontColor=#222222;align=center;fontSize=11;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="36" y="700" width="328" height="24" as="geometry"/></mxCell><mxCell id="sc11-18" value="&lt;b&gt;Отменить заказ?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Отмена бесплатна, пока мастер&lt;br&gt;не выехал. Сейчас мастер в пути —&lt;br&gt;удержится плата за выезд 15 000 сум." style="fontColor=#222222;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="410" y="470" width="250" height="150" as="geometry"/></mxCell><mxCell id="sc11-19" value="Нет" style="fontColor=#222222;rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#333333;fontSize=12;arcSize=18;" vertex="1" parent="1"><mxGeometry x="422" y="580" width="108" height="30" as="geometry"/></mxCell><mxCell id="sc11-20" value="Да, отменить" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B85450;strokeColor=#B85450;fontColor=#FFFFFF;fontSize=12;arcSize=18;" vertex="1" parent="1"><mxGeometry x="540" y="580" width="108" height="30" as="geometry"/></mxCell><mxCell id="sc11-21" value="Диалог подтверждения,&lt;br&gt;открывается по ссылке&lt;br&gt;«Отменить заказ»" style="fontColor=#222222;shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=6;size=12;" vertex="1" parent="1"><mxGeometry x="410" y="630" width="250" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="sc04v1" name="SC-04 Карточка услуги (v1 до исправления)"><mxGraphModel dx="800" dy="800" grid="0" gridSize="10" guides="1" page="1" pageWidth="700" pageHeight="800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sc04v1-1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#333333;strokeWidth=3;arcSize=6;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="360" height="740" as="geometry"/></mxCell><mxCell id="sc04v1-2" value="" style="rounded=1;fillColor=#333333;strokeColor=none;arcSize=50;" vertex="1" parent="1"><mxGeometry x="160" y="30" width="80" height="8" as="geometry"/></mxCell><UserObject id="sc04v1-3" label="&lt;b&gt;←  Замена смесителя&lt;/b&gt;" link="data:page/id,sc01"><mxCell style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;fontColor=#222222;fontSize=14;" vertex="1" parent="1"><mxGeometry x="36" y="46" width="248" height="30" as="geometry"/></mxCell></UserObject><mxCell id="sc04v1-4" value="♡" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fillColor=none;strokeColor=none;fontColor=#222222;align=right;fontSize=12;" vertex="1" parent="1"><mxGeometry x="254" y="46" width="110" height="30" as="geometry"/></mxCell><mxCell id="sc04v1-5" value="" style="line;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="36" y="80" width="328" height="1" as="geometry"/></mxCell><mxCell id="sc04v1-6" value="[ фото услуги ]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="36" y="92" width="328" height="120" as="geometry"/></mxCell><mxCell id="sc04v1-7" value="&lt;b style='font-size:15px'&gt;Замена / ремонт смесителя&lt;/b&gt;&lt;br&gt;★ 4,8 · 1 240 выполненных заказов · 1–2 ч" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fillColo